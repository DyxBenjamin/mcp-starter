{
  "name": "mcp-starter",
  "version": "0.3.0",
  "private": true,
  "description": "Agent-ready MCP starter with operable discovery resources, templates, prompts, and publishable package wiring.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/DyxBenjamin/mcp-starter",
  "bugs": {
    "url": "https://github.com/DyxBenjamin/mcp-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DyxBenjamin/mcp-starter.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/protocol",
    "docs/publishing.md"
  ],
  "bin": {
    "mcp-starter": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "catalog:generate": "tsx tools/generate-catalog.ts",
    "build": "npm run catalog:generate && tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "protocol:sync": "tsx tools/sync-protocol-docs.ts",
    "inspect": "npx -y @modelcontextprotocol/inspector --config inspector.config.json --server mcp-starter",
    "inspect:legacy": "npx -y @modelcontextprotocol/inspector --config inspector.config.json --server mcp-starter-legacy",
    "inspect:help": "npx -y @modelcontextprotocol/inspector --help",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^24.12.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
